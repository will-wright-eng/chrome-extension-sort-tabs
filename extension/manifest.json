{
  "manifest_version": 3,
  "name": "Domain Tab Sorter",
  "version": "1.0.0",
  "description": "Reorder the tabs in a window so tabs from the same domain are grouped and sorted alphabetically.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Sort tabs by domain",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
