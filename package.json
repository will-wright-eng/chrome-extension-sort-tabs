{
  "name": "domain-tab-sorter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that groups and alphabetically sorts a window's tabs by domain.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:icons": "bun run scripts/gen-icons.ts",
    "build": "bun run scripts/build.ts",
    "package": "bun run scripts/package.ts",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun run build && bun test --timeout 120000 ./tests/e2e/sort.e2e.ts",
    "check": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.0",
    "eslint": "^10.6.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
